# Скопируй в .env (локально) или задай как переменные окружения на Railway.
# Секреты (BOT_TOKEN, GROQ_API_KEY) в репозиторий НЕ коммитятся.

BOT_TOKEN=            # токен бота от @BotFather
CHANNEL=@aktivnik_nn  # публичный канал для постинга
OWNER_ID=             # твой Telegram user id (кому приходят ревью/админка)

GROQ_API_KEY=         # ключ Groq (можно GROQ_API_KEY_2..5 для ротации)

VK_SERVICE_TOKEN=     # сервисный ключ приложения VK (dev.vk.com) — для парсинга VK-групп

FRESH_WINDOW_DAYS=2       # окно «новизны» поста при проверке
CHECK_INTERVAL_SECONDS=900  # период опроса каналов, сек

# На Railway: смонтируй том и укажи путь, чтобы БД и список каналов переживали редеплой
DATA_DIR=/data

TELEGRAM_PROXY=       # оставь пустым на сервере
